# Configuration / Secrets for StockJomla
# ---------------------------------------
# NOTE: This is a frontend-only (static SPA) demo. There are NO secret API keys
# required at runtime — all data is stored in the browser's localStorage.
# WhatsApp integration uses the public wa.me link (no API key needed).
#
# If you later add a backend / WhatsApp Business API / payment gateways,
# put your secrets BELOW and make sure this file is NOT committed to a public
# Git repo (it is listed in .gitignore).

# ---- App ----
VITE_APP_NAME=StockJomla
VITE_APP_URL=https://your-domain.ma

# ---- WhatsApp Business (optional, if you add backend integration) ----
VITE_WHATSAPP_NUMBER=212661234567
# WHATSAPP_API_TOKEN=your-whatsapp-cloud-api-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ---- Payment gateway (optional future integration) ----
# CIH_MERCHANT_ID=
# ATTIJARI_MERCHANT_ID=

# ---- Admin (demo only — change in real backend) ----
VITE_DEMO_ADMIN_EMAIL=admin@stockjomla.ma
VITE_DEMO_ADMIN_PASSWORD=admin123
VITE_DEMO_SUPPLIER_EMAIL=demo@stockjomla.ma
VITE_DEMO_SUPPLIER_PASSWORD=demo123
